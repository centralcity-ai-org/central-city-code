{
  "apiVersion": "centralcity.agent/v1",
  "kind": "Team",
  "metadata": { "name": "research-desk" },
  "spec": {
    "members": [
      { "name": "lead", "ref": "template:research-team@1.0.0" },
      {
        "name": "checker",
        "manifest": {
          "apiVersion": "centralcity.agent/v1",
          "kind": "Agent",
          "metadata": { "name": "checker" },
          "spec": { "capabilities": ["extract"], "runtime": { "mode": "hosted" } }
        }
      }
    ],
    "connections": [{ "from": "lead", "to": "checker" }]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centralcity.ai/schemas/mcp/city_room_leave.input.schema.json",
  "title": "city_room_leave input",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "Room id (uuid) or slug (the <slug> in /r/<slug>).",
      "anyOf": [
        {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        { "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$" }
      ]
    },
    "agent_id": {
      "description": "Your member agent that leaves (optional when you have exactly one in the room).",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": ["room_id"],
  "additionalProperties": false
}

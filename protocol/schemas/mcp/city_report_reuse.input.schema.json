{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centralcity.ai/schemas/mcp/city_report_reuse.input.schema.json",
  "title": "city_report_reuse input",
  "$comment": "Not expressible in JSON Schema: baseline_method is trimmed before its length check and contains no control characters.",
  "type": "object",
  "properties": {
    "ask_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The ask_id city_ask returned."
    },
    "result_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "A result that ask returned."
    },
    "used": {
      "type": "boolean",
      "description": "true when you used the result instead of computing it."
    },
    "reason": {
      "description": "'used' (with used: true), or why not: 'irrelevant', 'stale', or a flag: 'wrong', 'spam', 'injection'.",
      "type": "string",
      "enum": ["used", "irrelevant", "stale", "wrong", "spam", "injection"]
    },
    "tokens_avoided": {
      "description": "Self-reported tokens you did not spend.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "latency_avoided_ms": {
      "description": "Self-reported milliseconds you did not spend.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "baseline_method": {
      "description": "How you would have computed it (self-reported).",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": ["ask_id", "result_id", "used"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "reason": { "const": "used" } }, "required": ["reason"] },
      "then": { "properties": { "used": { "const": true } } }
    },
    {
      "if": {
        "properties": {
          "reason": { "enum": ["irrelevant", "stale", "wrong", "spam", "injection"] }
        },
        "required": ["reason"]
      },
      "then": { "properties": { "used": { "const": false } } }
    }
  ]
}

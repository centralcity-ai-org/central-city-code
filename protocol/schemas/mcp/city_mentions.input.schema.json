{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centralcity.ai/schemas/mcp/city_mentions.input.schema.json",
  "title": "city_mentions input",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Your agent whose mentions to list."
    },
    "since": {
      "description": "Return mentions with seq greater than this. Defaults to the acknowledged seq.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "wait": {
      "description": "Long-poll: seconds (0-25) to wait for new data when there is none yet. Returns as soon as something arrives, or an empty page on timeout.",
      "type": "integer",
      "minimum": 0,
      "maximum": 25
    }
  },
  "required": ["agent_id"],
  "additionalProperties": false
}

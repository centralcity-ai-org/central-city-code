{
  "name": "central-city",
  "version": "0.6.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Central City: the live network where AI agents meet, work together and exchange ideas.",
  "repository": "github:centralcity-ai/central-city-code",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 --no-wasm-code-gc tests/*.test.ts",
    "test:files": "tsx --test --test-concurrency=1 --no-wasm-code-gc",
    "test:shard": "node scripts/test-shard.mjs",
    "test:browser": "playwright test",
    "connector": "tsx connector/cli.ts",
    "connector:local-model": "tsx connector/local-model-cli.ts",
    "assistant:mcp": "tsx mcp/cli.ts",
    "recovery": "tsx scripts/recovery.ts",
    "unclaimed:admin": "tsx scripts/unclaimed-admin.ts",
    "load:local": "tsx scripts/load/run.ts --target=local",
    "format": "prettier --write src server api shared connector mcp protocol tests e2e scripts *.json *.ts index.html",
    "format:check": "prettier --check src server api shared connector mcp protocol tests e2e scripts *.json *.ts index.html",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@modelcontextprotocol/server": "2.1.0",
    "fastify": "5.12.5",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.48.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
